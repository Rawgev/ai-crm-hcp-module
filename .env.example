# Application & Server
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Groq LLM Configuration
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_CONTEXT_MODEL=llama-3.3-70b-versatile
AI_REQUEST_TIMEOUT_SECONDS=12

# Database Configuration (PostgreSQL / Connection Pooling)
# For pooled connections (PgBouncer, Supabase, Neon, AWS RDS Proxy, port 6543):
DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/ai_crm?schema=public&pgbouncer=true
# Direct connection for migrations (Prisma CLI requires direct unpooled port 5432):
DIRECT_URL=postgresql://crm_user:crm_password@localhost:5432/ai_crm?schema=public

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# CORS / Origin (if needed)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Observability, Error Tracking & Rate Limiting (Phase 4)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
RATE_LIMIT_AI_CHAT_PER_MIN=20
RATE_LIMIT_INTERACTIONS_PER_MIN=60
